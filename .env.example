# ============================================================
# nexteduwise — monorepo root environment
# Copy this file to .env (same folder) and fill real values.
# Never commit the real .env file.
# ============================================================

# ---- Database (MongoDB Atlas / local) ----
# For MongoDB Atlas, paste your connection string here.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# ---- API auth ----
JWT_SECRET=use-a-long-random-secret
SETUP_KEY=use-a-separate-random-onboarding-key
SECRET_KEY=nexteduwise-admin-secret

# ---- API runtime (optional, defaults exist in code) ----
PORT=3000
WEB_ORIGIN=http://localhost:5173
# Override the browser User-Agent sent to Shiksha/College360 APIs (defaults to Chrome 128).
# Set this if the APIs start returning 403 again due to updated bot detection.
BROWSER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36
COUNSELOR_CONTACT_PHONE=+910000000000
COUNSELOR_CONTACT_EMAIL=counselor@example.com

# ---- Web (Vite) runtime config — loaded from apps/web/.env in dev ----
VITE_API_URL=http://localhost:3000
VITE_MAPBOX_ACCESS_TOKEN=<paste-your-mapbox-public-token>
